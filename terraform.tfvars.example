aws_region     = "us-east-1"
project_name   = "escapa"
instance_type  = "t3.large"

# Sua chave publica SSH (nao a privada!):
#   cat ~/.ssh/id_ed25519.pub
ssh_public_key = "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAI... seu-usuario@sua-maquina"

# Descubra seu IP publico com: curl ifconfig.me
admin_cidr = "SEU.IP.PUBLICO.AQUI/32"

# Opcional: se preenchido, o node ja sobe com o ArgoCD apontando pro seu repo GitOps
gitops_repo_url = "https://github.com/SEU_ORG/gitops-escapa.git"

# GHCR - imagens privadas do frontend/backend
# Gere em: github.com/settings/tokens -> scope "read:packages"
github_username = "SEU_ORG_OU_USUARIO"
github_pat      = "ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Cloudflare - dashboard.cloudflare.com
#   api_token: My Profile > API Tokens > Create Token (Account:Cloudflare Tunnel:Edit + Zone:DNS:Edit)
#   account_id e zone_id: aparecem na barra lateral direita do dashboard do dominio
cloudflare_api_token  = "SEU_API_TOKEN"
cloudflare_account_id = "SEU_ACCOUNT_ID"
cloudflare_zone_id    = "SEU_ZONE_ID"
root_domain           = "escapa.com.br"
frontend_subdomain    = "app"
backend_subdomain     = "api"
